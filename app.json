{
  "expo": {
    "name": "Brewlog",
    "slug": "brewlog",
    "scheme": "brewlog",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.brewlog.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.brewlog.app"
    },
    "plugins": [
      "expo-router",
      "@sentry/react-native",
      "expo-localization",
      "expo-sqlite",
      "expo-font",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
