{
  "expo": {
    "name": "Brewlog",
    "slug": "brewlog",
    "scheme": "brewlog",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.brewlog.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.brewlog.app",
      "config": {
        "googleMaps": {
          "apiKey": "REPLACE_WITH_ANDROID_MAPS_API_KEY"
        }
      }
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "@sentry/react-native",
      "expo-localization",
      "expo-sqlite",
      "expo-font",
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Brewlog uses your location to find specialty coffee near you."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
