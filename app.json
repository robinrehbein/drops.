{
  "expo": {
    "name": "Drops",
    "slug": "brewlog",
    "scheme": "drop",
    "version": "0.2.0",
    "orientation": "default",
    "icon": "./assets/drop-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "de.birneklub.drop",
      "supportsTablet": true,
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Drops uses your location to find specialty coffee near you.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": false
      }
    },
    "android": {
      "package": "de.birneklub.drop",
      "adaptiveIcon": {
        "foregroundImage": "./assets/drop-icon.png",
        "backgroundColor": "#F6EAD4"
      }
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6EAD4"
    },
    "privacy": "https://robinrehbein.de/drop/privacy",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "@sentry/react-native",
      "expo-localization",
      "expo-sqlite",
      "expo-font",
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Drops uses your location to find specialty coffee near you."
        }
      ],
      "@react-native-community/datetimepicker",
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "headers": {
          "Cross-Origin-Embedder-Policy": "credentialless",
          "Cross-Origin-Opener-Policy": "same-origin"
        }
      },
      "eas": {
        "projectId": "c4d1539b-70ea-4412-8ea0-d3fbbdb99900"
      }
    },
    "owner": "birneklub"
  }
}
