{
  "expo": {
    "name": "Brewlog",
    "slug": "brewlog",
    "scheme": "brewlog",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "de.birneklub.brewlog",
      "supportsTablet": false
    },
    "android": {
      "package": "de.birneklub.brewlog",
      "config": {
        "googleMaps": {
          "apiKey": "REPLACE_WITH_ANDROID_MAPS_API_KEY"
        }
      }
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "@sentry/react-native",
      "expo-localization",
      "expo-sqlite",
      "expo-font",
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Brewlog uses your location to find specialty coffee near you."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "headers": {
          "Cross-Origin-Embedder-Policy": "credentialless",
          "Cross-Origin-Opener-Policy": "same-origin"
        }
      },
      "eas": {
        "projectId": "c4d1539b-70ea-4412-8ea0-d3fbbdb99900"
      }
    },
    "owner": "birneklub"
  }
}
