<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the local database (with its WAL files) is everything the user tracks, so it goes into
     the encrypted cloud backup and moves along when switching phones. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
